# Generated by oe-go-mod-fetcher.py --use-hybrid
# Custom module cache builder for fast parallel processing
# This replaces BitBake's slow sequential gomodgit processing

DEPENDS += " go-dirhash-native"

# Ensure Go module cache objects remain writable
GOBUILDFLAGS:append = " -modcacherw"

# Set up Go module cache directory (matches our hybrid module cache location)
GOMODCACHE = "${S}/pkg/mod"
GO_MOD_CACHE_DIR = "${@os.path.relpath(d.getVar('GOMODCACHE'), d.getVar('UNPACKDIR'))}"
do_unpack[cleandirs] += "${GOMODCACHE}"

